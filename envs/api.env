# Shipped defaults — tracked by git, do not edit.
# Put your own settings in api.local.env, which is gitignored
# and loaded after this file. See envs/README.md.

APPLICATION_NAME=yt_api

API_HOST=0.0.0.0
API_PORT=8000
# Uvicorn worker processes, each a full copy of the application. The API only
# validates a request and puts it on the queue — the downloading happens in
# yt_worker — so one worker is enough for any self-hosted deployment, and four
# of them is what gets the container OOM-killed on a small VPS.
API_WORKERS=1

# Empty leaves the API unauthenticated, which is why docker-compose.yml
# publishes its port on 127.0.0.1 only. Set this in api.local.env to require
# "Authorization: Bearer <token>", then publish the port wherever you need it.
API_TOKEN=

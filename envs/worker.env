# Shipped defaults — tracked by git, do not edit.
# Put your own settings in worker.local.env, which is gitignored
# and loaded after this file. See envs/README.md.

APPLICATION_NAME=yt_worker

# How many downloads actually run at once. 1 is strictly sequential, which is
# what a small host wants: one download's worth of staging space, one FFmpeg
# pass and one share of the connection. This bounds what runs, not what may be
# queued — a selection of twenty still queues twenty and they wait their turn.
MAX_SIMULTANEOUS_DOWNLOADS=2
MAX_DOWNLOAD_THREADS=10
# Refuse a download when less than this many MB are free for staging.
# 0 turns the check off.
MIN_FREE_SPACE_MB=512
# Max download speed, e.g. 500K or 4.2M. Empty means no limit.
DOWNLOAD_RATE_LIMIT=
# Preferred language for titles, descriptions and chapters, e.g. ru.
# Empty leaves whatever the site serves by default.
METADATA_LANGUAGE=

STORAGE_PATH=/filestorage

THUMBNAIL_FRAME_SECOND=10.0
INSTAGRAM_ENCODE_TO_H264=True
FACEBOOK_ENCODE_TO_H264=True
